# Copy to .env.local and fill in the values. Never commit .env.local.

# NeonDB Connection URL
DATABASE_URL=


# Google OAuth client (Google Cloud Console -> APIs & Services -> Credentials).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# The Google Calendar API must be enabled on the same project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gemini, the real planner (Google AI Studio -> API keys). Only read when the planner is real;
# without it every proposal fails with planner.llm instead of stopping the server.
GEMINI_API_KEY=
# Model for the planner. Unset means the adapter's default (gemini-3.5-flash-lite).
GEMINI_MODEL=

# next-auth. Generate the secret with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Where each port comes from. Unset means everything real (see the source table in the README).
# A per-port variable beats SECRETARY_MODE, which beats the default.

# Preset for every port at once: normal (all real) or demo (all fake with the dev sign-in).
# The dev sign-in only starts when NEXTAUTH_URL points at localhost.
# SECRETARY_MODE=demo

# How to sign in: google or dev. SECRETARY_AUTH=dev has no Google token, so the calendar must be fake.
# SECRETARY_AUTH=dev

# One port at a time: real or fake.
# SECRETARY_CALENDAR=fake
# SECRETARY_CATALOG=fake
# SECRETARY_PLANNER=fake
# SECRETARY_MANDATE=fake
# The real store writes the confirmed itinerary (trips / trip_items) to NeonDB and needs DATABASE_URL.
# Writing also needs SECRETARY_CATALOG=real (line items point at service rows).
# SECRETARY_STORE=fake
# SECRETARY_IDENTITY=fake
# The real profile reads the date of birth from NeonDB and needs DATABASE_URL.
# SECRETARY_PROFILE=fake

# --- contract/ settlement (SECRETARY_MANDATE=real only) ---
# This app talks to contract/src/server.ts over loopback HTTP (see
# src/lib/dev-contracts/network.ts); CONTRACT_SERVER_URL defaults to
# http://127.0.0.1:4900 and rarely needs overriding.

# The mandate real adapter pays token.compact's sendToken to this fixed
# devnet address for every public payment -- the catalog's payee is still a
# placeholder string (not a real Midnight address), so it can't be used as
# the recipient yet. See src/adapters/mandate/real.ts.
MANDATE_SETTLEMENT_RECIPIENT=

# Same as above, but for every private payment: a shielded (mn_shield-addr_...)
# address or raw coin public key hex, paid via shielded-token.compact's
# mint_and_send instead of sendToken. Unset means the real adapter reports
# capabilities.privateSettlement = false and the UI hides the private toggle
# entirely (set once, at adapter creation -- not re-checked per request).
# Needs contract/.env's SHIELDED_TOKEN_ADDRESS configured too.
MANDATE_SETTLEMENT_RECIPIENT_SHIELDED=
