# Copy to .env.local and fill in the values. Never commit .env.local.

# Google OAuth client (Google Cloud Console -> APIs & Services -> Credentials).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# The Google Calendar API must be enabled on the same project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# next-auth. Generate the secret with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
