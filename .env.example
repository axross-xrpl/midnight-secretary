# Copy this file to .env.local and fill in real values. .env* is git-ignored
# except this file (see .gitignore's `.env*` / `!.env.example` rule).

# --- /dev/contracts faucet backend (server-side only, never sent to the browser) ---
# Same devnet connection this project's contract/.env already uses.
NETWORK_ID=undeployed
# Same value, but readable in the browser -- the age-verification panel's
# wallet-connector flow needs it client-side to call wallet.connect(networkId).
NEXT_PUBLIC_NETWORK_ID=undeployed
INDEXER_HTTP=http://127.0.0.1:8088/api/v4/graphql
INDEXER_WS=ws://127.0.0.1:8088/api/v4/graphql/ws
NODE_URL=ws://127.0.0.1:9944
PROOF_SERVER=http://127.0.0.1:6300

# Owner/minter seed used by the faucet API routes to run sendToken /
# mint_and_send on a connected end user's behalf. Same seed used to deploy
# the token contracts (see contract/.env). NEVER commit a real seed.
DEPLOYER_SEED=

# --- Deployed contract addresses (deploy from contract/ via WSL first, then paste here) ---
# NEXT_PUBLIC_* vars are readable both server-side (faucet routes) and
# client-side (age-verification's browser-side wallet-connector calls).
NEXT_PUBLIC_TOKEN_ADDRESS=
NEXT_PUBLIC_SHIELDED_TOKEN_ADDRESS=
NEXT_PUBLIC_AGE_VERIFICATION_ADDRESS=
