{
  "name": "midnight-secretary",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n next,contract -c blue,green \"npm:dev:next\" \"npm:dev:contract-server\"",
    "dev:next": "next dev",
    "dev:contract-server": "node scripts/start-contract-server.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db-check.mts",
    "i18n:report": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/i18n-report.mts",
    "prepare": "lefthook install || echo \"lefthook install skipped\""
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@google/genai": "^2.21.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "next-auth": "^4.24.15",
    "next-intl": "^4.13.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "ts-pattern": "^5.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.10",
    "lefthook": "^2.1.12",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vitest": "^4.1.11"
  }
}
