# Copy this file to .env and fill in real values. .env is git-ignored (see root .gitignore's `.env*` rule).

NETWORK_ID=undeployed
INDEXER_HTTP=http://127.0.0.1:8088/api/v4/graphql
INDEXER_WS=ws://127.0.0.1:8088/api/v4/graphql/ws
NODE_URL=ws://127.0.0.1:9944
PROOF_SERVER=http://127.0.0.1:6300

# Seed for the wallet that pays deployment fees and mints the initial supply.
# Get this from the local-devnet wallet-setup script (see basic-start skill Step 3).
# NEVER commit a real seed.
DEPLOYER_SEED=

TOKEN_NAME=Midnight Secretary Token
TOKEN_SYMBOL=MST
TOTAL_SUPPLY=1000000

# Spending budgets granted to the owner/agent at deploy time. Each is decremented
# by every sendToken / mint_and_send call and refuses the call once exhausted;
# reset either with the set-allowance scripts.
SEND_ALLOWANCE=100000
MINT_ALLOWANCE=100000

# --- contract server (src/server.ts) ---
# Deployed addresses the long-lived faucet server connects to at startup --
# same values as root .env.local's NEXT_PUBLIC_TOKEN_ADDRESS /
# NEXT_PUBLIC_SHIELDED_TOKEN_ADDRESS. Redeploying either contract means
# updating it in both places and restarting `npm run dev`.
TOKEN_ADDRESS=
SHIELDED_TOKEN_ADDRESS=
CONTRACT_SERVER_PORT=4900
