# Copy this file to .env and fill in real values. .env is git-ignored (see root .gitignore's `.env*` rule).

# Midnight Preview (the public network the contracts are deployed on). The
# proof server stays local: `docker compose -f devnet.yml up -d --wait proof-server`.
# NETWORK_ID must be lowercase ("Undeployed" fails with InvalidNetworkId).
NETWORK_ID=preview
INDEXER_HTTP=https://indexer.preview.midnight.network/api/v4/graphql
INDEXER_WS=wss://indexer.preview.midnight.network/api/v4/graphql/ws
NODE_URL=wss://rpc.preview.midnight.network
PROOF_SERVER=http://127.0.0.1:6300
# Local devnet instead (`docker compose -f devnet.yml up -d --wait`):
# NETWORK_ID=undeployed
# INDEXER_HTTP=http://127.0.0.1:8088/api/v4/graphql
# INDEXER_WS=ws://127.0.0.1:8088/api/v4/graphql/ws
# NODE_URL=ws://127.0.0.1:9944

# The first sync against Preview replays the chain from genesis (about ten
# minutes) and needed more heap than Node's default for us:
# NODE_OPTIONS=--max-old-space-size=6144. Stopping the server with Ctrl-C
# saves the shielded/unshielded progress under .wallet-cache (git-ignored);
# the DUST wallet always syncs from scratch.

# Seed for the wallet that pays deployment fees and mints the initial supply
# (openssl rand -hex 32). On Preview, fund its address (`npm run address`) from
# the faucet, then `npm run register-dust`; on a local devnet use `npm run fund`.
# Only this key can call sendToken / mint_and_send on the contracts it deployed.
# NEVER commit a real seed.
DEPLOYER_SEED=

TOKEN_NAME=Midnight Secretary Token
TOKEN_SYMBOL=MST
TOTAL_SUPPLY=1000000

# Spending budgets granted to the owner/agent at deploy time. Each is decremented
# by every sendToken / mint_and_send call and refuses the call once exhausted;
# reset either with the set-allowance scripts.
SEND_ALLOWANCE=100000
MINT_ALLOWANCE=100000

# --- contract server (src/server.ts) ---
# Deployed addresses the long-lived faucet server connects to at startup --
# same values as root .env.local's NEXT_PUBLIC_TOKEN_ADDRESS /
# NEXT_PUBLIC_SHIELDED_TOKEN_ADDRESS. Redeploying either contract means
# updating it in both places and restarting `npm run dev`.
# The team's Preview deployment is listed in the root README ("With Midnight Preview").
TOKEN_ADDRESS=
SHIELDED_TOKEN_ADDRESS=
CONTRACT_SERVER_PORT=4900

# --- age-verification ---
# Seed of the person registering/proving their age. They pay their own fees
# and own their own identity secret, so this is separate from DEPLOYER_SEED
# (see contract/src/age-verification/witnesses.ts) -- falls back to
# DEPLOYER_SEED when unset, which is fine for a single-wallet devnet run.
# Give each test registrant a different funded seed to exercise the
# multi-registrant path.
USER_SEED=

# Dates are YYYYMMDD integers on both the CLI and in the circuit:
#   npm run register-age -- <contractAddress> 19900215
#   npm run prove-age    -- <contractAddress> 19900215 20060909
# prove-age's dateOfBirth argument MUST match what register-age was called
# with for the same seed -- the circuit checks it against the stored
# commitment, not just against the cutoff. The cutoff is the verifier's
# number -- today minus 20 years for Japanese alcohol/tobacco (the purchase
# age stayed at 20 when the civil age of majority dropped to 18 in 2022).

# --- age-verification via src/server.ts (GET /age-verification/registration,
# POST /age-verification/register, POST /age-verification/prove) ---
# Unlike the CLI scripts above (one wallet seed per registrant), the server
# takes an opaque `accountRef` string per request (the app derives one per
# user -- see identityIds.identityOf in src/adapters/runtime.ts) and derives
# that user's identitySecret/dobSalt from it, the same way the CLI derives
# them from a seed. Many distinct accountRefs can register/prove against the
# one deployment. Still a dev-only stand-in: the date of birth and the
# identity secret both pass through this server instead of staying on the
# traveler's own device -- the real version proves from a connected wallet.
# Optional: only set this to enable the routes.
AGE_VERIFICATION_ADDRESS=
# GET  /age-verification/registration?accountRef=<ref>
#        -> { identity, registered, dobCommitment?, contractAddress }
# POST /age-verification/register { accountRef, dateOfBirth: "YYYYMMDD" }
#        -> { identity, txId, blockHeight }
#        Fails with "Identity already registered" on a second call for the
#        same accountRef against this deployment.
# POST /age-verification/prove { accountRef, cutoffDate: "YYYYMMDD" }
#        -> { identity, txId, blockHeight, cutoffDate, isAdult }
#        The caller computes cutoffDate itself (this server no longer does --
#        the age limit varies per service, not always 20 years). Fails with
#        "Identity not registered" if register wasn't called first.
